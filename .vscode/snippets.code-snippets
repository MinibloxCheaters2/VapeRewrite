{
	"Module": {
		"scope": "typescript",
		"isFileTemplate": true,
		"description": "Template for modules",
		"exclude": [
			"packages/core/**",
			"packages/*/src/features/modules/impl/legit/*.ts"
		],
		"body": [
			"import Category from \"@vape/core/features/modules/api/Category\"",
			"import Mod from \"@vape/core/features/modules/api/Module\"",
			"",
			"export default class $TM_FILENAME_BASE extends Mod {",
			"\tname = \"$TM_FILENAME_BASE\";",
			"\tcategory = Category.${TM_DIRECTORY/.*(?:\\\\|\\u002f)([^\\\\\\u002f]+)$/${1:/upcase}/};",
			"\t$0",
			"}"
		]
	}
}
